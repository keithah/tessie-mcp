{
  "name": "tessie-mcp",
  "version": "3.0.0",
  "description": "Self-hosted personal Tessie MCP server",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run build && npm test"
  },
  "keywords": ["mcp", "tessie", "tesla", "self-hosted"],
  "license": "MIT",
  "engines": { "node": ">=22" },
  "overrides": { "path-to-regexp": "^8.4.2" },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "^5.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.17.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
